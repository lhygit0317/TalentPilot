    "/resumes/batch-imports": {
      "post": {
        "operationId": "post-resume-batch-import",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "encoding": {
                "chan": {
                  "contentType": "text/plain"
                },
                "files": {
                  "contentType": "application/pdf,application/octet-stream"
                },
                "targetDepartmentId": {
                  "contentType": "text/plain"
                }
              },
              "schema": {
                "properties": {
                  "chan": {
                    "enum": [
                      "social",
                      "campus"
                    ],
                    "type": "string"
                  },
                  "files": {
                    "items": {
                      "contentEncoding": "binary",
                      "contentMediaType": "application/octet-stream",
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "targetDepartmentId": {
                    "type": "string"
                  }
                },
                "required": [
                  "files",
                  "chan",
                  "targetDepartmentId"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
